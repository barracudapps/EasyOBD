{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EasyOBD",
  "version": "0.1.0",
  "identifier": "com.barracudapps.easyobd",
  "build": {
    "beforeDevCommand": "npm run build:wasm && npm --prefix ui run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "EasyOBD",
        "width": 1360,
        "height": 860,
        "minWidth": 380,
        "minHeight": 600,
        "backgroundColor": "#0b0f17"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Diagnostic auto OBD-II en 3D",
    "longDescription": "Diagnostic automobile OBD-II pédagogique : visualisation 3D des pannes, solutions, coût des pièces, tutoriels d'entretien, questionnaire et analyse audio, mode formation et mode expert.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
